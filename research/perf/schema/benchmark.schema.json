{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Victoria II benchmark run",
  "type": "object",
  "required": [
    "schema_version",
    "label",
    "timestamp",
    "process",
    "days",
    "wall_s",
    "cpu_s",
    "wall_ms_per_day",
    "cpu_ms_per_day",
    "max_rss_mb"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "label": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "process": { "type": "string" },
    "pid": { "type": "integer" },
    "save_sha256": { "type": "string" },
    "days": { "type": "integer", "minimum": 1 },
    "wall_s": { "type": "number", "minimum": 0 },
    "cpu_s": { "type": "number", "minimum": 0 },
    "wall_ms_per_day": { "type": "number", "minimum": 0 },
    "cpu_ms_per_day": { "type": "number", "minimum": 0 },
    "max_rss_mb": { "type": "number", "minimum": 0 },
    "samples": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string" },
    "sample_error": { "type": "string" },
    "host": {
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "machine": { "type": "string" },
        "python": { "type": "string" }
      }
    }
  }
}
